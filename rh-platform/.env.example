# Conexao com o Postgres.
# Local (Docker/Postgres nativo):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rh_platform?schema=public"

# Vercel Postgres / Neon (exemplo):
# DATABASE_URL="postgres://<user>:<password>@<host>/<db>?sslmode=require"

# --- Autenticacao ---
# Segredo para assinar as sessoes (troque por um valor aleatorio em producao).
AUTH_SECRET="troque-por-um-segredo-aleatorio-longo"

# Palavra-passe exigida para criar conta (default: B4YOU2026@).
SIGNUP_ACCESS_CODE="B4YOU2026@"

# E-mail do admin principal (sempre ADMIN; libera acesso admin aos demais).
PRINCIPAL_ADMIN_EMAIL="b4you.rh@gmail.com"
